{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimpMusic",
  "version": "0.1.0",
  "identifier": "com.slfftz2011.simpmusic",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SimpMusic",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/music-api"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "SimpMusic 桌面音乐播放器",
    "longDescription": "基于 Vue3 + Tauri + api-enhanced 构建的网易云音乐客户端，前后端分离架构，桌面端内置 API 服务。",
    "category": "Music",
    "copyright": "slfftz2011"
  }
}
